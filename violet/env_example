# --- Phase 7 B.2: fewer model calls ---
# 1 = IntentAgent is not offered query_memory while no event memory could be found (saves a call)
VIOLET_INTENT_HIDE_EMPTY_MEMORY_TOOL=1
# 1 = background memory jobs may end right after successful writes when the model calls memory_done
VIOLET_MEMORY_FINISH_SIGNAL=1
# 1 = MemoryAgent is not offered query_memory while there is no event memory at all (user-disabled ones count)
VIOLET_MEMORY_HIDE_EMPTY_QUERY_TOOL=1
# 1 = old nickname core memories are not shown to Chat while a confirmed profile name exists
VIOLET_CONTEXT_HIDE_LEGACY_NICKNAME=1
